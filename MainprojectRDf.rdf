                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/orange/ontologies/2026/3/untitled-ontology-19#Fertilizer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>&quot;A plant cultivated by farmers for food production.&quot;</rdfs:comment>
        <rdfs:label>Crop</rdfs:label>
    </owl:Class>
    


